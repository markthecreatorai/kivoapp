# ==============================
# KIVO ENV TEMPLATE
# ==============================
# Use this file as reference only. Do not commit real secrets.

# ---------- Frontend (Vite) ----------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_APP_URL=http://localhost:5173
VITE_SUPPORT_EMAIL=suporte@kivohub.com.br

# ---------- Backend / Edge Functions (Supabase Secrets) ----------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
EMAIL_FROM_AUTH=Kivo Auth <auth@mail.kivohub.com.br>
EMAIL_FROM_BILLING=Kivo Billing <billing@mail.kivohub.com.br>
EMAIL_FROM_NOTIFY=Kivo Notify <notify@mail.kivohub.com.br>
EMAIL_FROM_DEFAULT=Kivo <notify@mail.kivohub.com.br>
APP_URL=https://www.kivohub.com.br
SUPPORT_EMAIL=suporte@kivohub.com.br

# ---------- Supabase Auth SMTP (Dashboard config values) ----------
# Host: smtp.resend.com
# Port: 587
# Username: resend
# Password: <same as RESEND_API_KEY>
# Sender Name: Kivo
# Sender Email: auth@mail.kivohub.com.br

# ---------- Environment targets ----------
# development: APP_URL=http://localhost:5173
# preview:     APP_URL=https://<preview-domain>.vercel.app
# production:  APP_URL=https://www.kivohub.com.br
